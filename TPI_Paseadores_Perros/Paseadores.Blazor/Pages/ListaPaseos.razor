@page "/paseos"
@using DTOs
@using API.Clients
@inject PaseoApiClient PaseoApi
@inject PaseadorApiClient PaseadorApi
@inject PerroApiClient PerroApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h2>Paseos</h2>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
    @if (!string.IsNullOrEmpty(mensajeOk))
    {
        <div class="alert alert-success">@mensajeOk</div>
    }

    <!-- ===== FORMULARIO ===== -->
    <div class="card mb-4">
        <div class="card-header">
            @(EsAlta ? "Nuevo paseo" : $"Editando paseo #{paseo.Id}")
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Paseador</label>
                    <select class="form-select" @bind="paseo.PaseadorId">
                        <option value="0">-- Elegir --</option>
                        @if (listaPaseadores != null)
                        {
                            @foreach (var p in listaPaseadores)
                            {
                                <option value="@p.Id">@p.Apellido, @p.Nombre (@p.Zona)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Perro</label>
                    <select class="form-select" @bind="paseo.PerroId">
                        <option value="0">-- Elegir --</option>
                        @if (listaPerros != null)
                        {
                            @foreach (var p in listaPerros)
                            {
                                <option value="@p.Id">@p.Nombre (@p.Raza)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha y hora</label>
                    <input type="datetime-local" class="form-control" @bind="paseo.FechaHoraInicio" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Duración (min)</label>
                    <input type="number" class="form-control" min="15" max="480" step="15" @bind="paseo.DuracionMinutos" />
                </div>
            </div>
            <small class="text-muted">El precio lo calcula el sistema con la tarifa del paseador.</small>

            @if (erroresValidacion.Any())
            {
                <ul class="alert alert-warning mt-3 mb-0">
                    @foreach (var error in erroresValidacion)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Guardar" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
                <button class="btn btn-secondary" @onclick="Limpiar" disabled="@guardando">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- ===== BÚSQUEDA CON FILTROS ===== -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Paseador</label>
                    <select class="form-select" @bind="filtroPaseadorId">
                        <option value="0">Todos los paseadores</option>
                        @if (listaPaseadores != null)
                        {
                            @foreach (var p in listaPaseadores)
                            {
                                <option value="@p.Id">@p.Apellido, @p.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" @bind="filtroDesde" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" @bind="filtroHasta" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-primary w-100 mb-1" @onclick="Buscar">Buscar</button>
                    <button class="btn btn-outline-secondary w-100" @onclick="VerTodos">Ver todos</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== LISTADO ===== -->
    @if (listaPaseos == null)
    {
        <div class="alert alert-info">Cargando datos...</div>
    }
    else if (!listaPaseos.Any())
    {
        <div class="alert alert-secondary">No se encontraron paseos.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Paseador</th>
                    <th>Perro</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Minutos</th>
                    <th>Precio</th>
                    <th style="width: 160px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in listaPaseos)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.PaseadorNombre</td>
                        <td>@p.PerroNombre</td>
                        <td>@p.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@p.FechaHoraInicio.AddMinutes(p.DuracionMinutos).ToString("HH:mm")</td>
                        <td>@p.DuracionMinutos</td>
                        <td>@p.PrecioTotal.ToString("N2")</td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => Editar(p)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(p)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<PaseoDTO>? listaPaseos;
    private List<PaseadorDTO>? listaPaseadores;   // para los combos y el filtro
    private List<PerroDTO>? listaPerros;
    private PaseoDTO paseo = NuevoPaseo();
    private List<string> erroresValidacion = new();
    private string? mensajeError;
    private string? mensajeOk;
    private int filtroPaseadorId;                 // 0 = todos
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;
    private bool guardando;

    // Id 0 = todavía no existe en la base => es un alta
    private bool EsAlta => paseo.Id == 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarCombosAsync();
        await CargarAsync();
    }

    private static PaseoDTO NuevoPaseo()
    {
        // Igual que en escritorio: arranca una hora más tarde, redondeado a la hora
        var enUnaHora = DateTime.Now.AddHours(1);
        return new PaseoDTO
        {
            FechaHoraInicio = new DateTime(enUnaHora.Year, enUnaHora.Month, enUnaHora.Day, enUnaHora.Hour, 0, 0),
            DuracionMinutos = 60
        };
    }

    private async Task CargarCombosAsync()
    {
        try
        {
            listaPaseadores = await PaseadorApi.GetAllAsync();
            listaPerros = await PerroApi.GetAllAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            listaPaseos = await PaseoApi.GetAllAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
    }

    // Búsqueda por criterio: la API filtra solo por los campos cargados
    private async Task Buscar()
    {
        mensajeError = null;
        mensajeOk = null;

        if (filtroDesde.HasValue && filtroHasta.HasValue && filtroDesde > filtroHasta)
        {
            mensajeError = "La fecha desde no puede ser posterior a la fecha hasta.";
            return;
        }

        try
        {
            int? paseadorId = filtroPaseadorId == 0 ? null : filtroPaseadorId;
            DateTime? hasta = filtroHasta?.Date.AddDays(1).AddSeconds(-1);
            listaPaseos = await PaseoApi.BuscarAsync(paseadorId, filtroDesde?.Date, hasta);
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
    }

    private async Task VerTodos()
    {
        filtroPaseadorId = 0;
        filtroDesde = null;
        filtroHasta = null;
        await CargarAsync();
    }

    // --- Validación a nivel UI (la misma que FormPaseos) ---
    private bool EsValido()
    {
        erroresValidacion.Clear();

        if (paseo.PaseadorId <= 0)
        {
            erroresValidacion.Add("Hay que elegir un paseador.");
        }

        if (paseo.PerroId <= 0)
        {
            erroresValidacion.Add("Hay que elegir un perro.");
        }

        if (paseo.DuracionMinutos < 15 || paseo.DuracionMinutos > 480)
        {
            erroresValidacion.Add("La duración debe estar entre 15 y 480 minutos.");
        }

        if (EsAlta && paseo.FechaHoraInicio < DateTime.Now)
        {
            erroresValidacion.Add("No se puede agendar un paseo en una fecha y hora que ya pasó.");
        }

        return !erroresValidacion.Any();
    }

    private async Task Guardar()
    {
        mensajeError = null;
        mensajeOk = null;

        if (!EsValido())
        {
            return;
        }

        guardando = true;

        try
        {
            if (EsAlta)
            {
                await PaseoApi.AddAsync(paseo);
            }
            else
            {
                await PaseoApi.UpdateAsync(paseo);
            }

            mensajeOk = EsAlta ? "Paseo creado con éxito." : "Paseo actualizado con éxito.";
            Limpiar();
            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para esta operación.";
        }
        catch (ApiException ex)
        {
            // Reglas de negocio del servicio (ej: el paseador ya tiene otro paseo en ese horario)
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(PaseoDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;
        erroresValidacion.Clear();

        // Copia: si editáramos el objeto de la lista, la tabla mostraría los cambios
        // sin haberlos guardado todavía
        paseo = new PaseoDTO
        {
            Id = seleccionado.Id,
            PaseadorId = seleccionado.PaseadorId,
            PerroId = seleccionado.PerroId,
            FechaHoraInicio = seleccionado.FechaHoraInicio,
            DuracionMinutos = seleccionado.DuracionMinutos
        };
    }

    private async Task Eliminar(PaseoDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;

        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Seguro que querés eliminar el paseo #{seleccionado.Id}?");

        if (!confirmado)
        {
            return;
        }

        try
        {
            await PaseoApi.DeleteAsync(seleccionado.Id);
            mensajeOk = "Paseo eliminado.";

            if (paseo.Id == seleccionado.Id)
            {
                Limpiar();
            }

            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para eliminar paseos.";
        }
        catch (ApiException ex)
        {
            // Ej: "El paseo ya está incluido en una liquidación..."
            mensajeError = ex.Message;
        }
    }

    private void Limpiar()
    {
        paseo = NuevoPaseo();
        erroresValidacion.Clear();
    }
}
