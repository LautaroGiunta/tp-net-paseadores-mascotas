@page "/reportes/actividad"
@using DTOs
@using API.Clients
@inject ReporteApiClient ReporteApi
@inject SesionService Sesion
@inject NavigationManager Navigation

<PageTitle>Actividad por perro</PageTitle>

<div class="container mt-4">
    <h2>Actividad por perro</h2>
    <p class="text-muted">Paseos realizados por cada perro en el período. Aparecen también los que no salieron.</p>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label">Desde</label>
            <input type="date" class="form-control" @bind="desde" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Hasta</label>
            <input type="date" class="form-control" @bind="hasta" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" @onclick="GenerarAsync" disabled="@cargando">
                @(cargando ? "Generando..." : "Generar")
            </button>
        </div>
        @if (filas != null && filas.Any())
        {
            <div class="col-md-4 fw-bold">
                @filas.Sum(f => f.CantidadPaseos) paseos, $@filas.Sum(f => f.Total).ToString("N2") en total
            </div>
        }
    </div>

    @if (filas == null)
    {
        <div class="alert alert-info">Cargando datos...</div>
    }
    else if (!filas.Any())
    {
        <div class="alert alert-secondary">No hay perros cargados.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Perro</th>
                    <th>Raza</th>
                    <th>Dueño</th>
                    <th class="text-end">Paseos</th>
                    <th class="text-end">Minutos</th>
                    <th class="text-end">Gastado</th>
                    <th>Último paseo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in filas)
                {
                    <tr>
                        <td>@f.PerroNombre</td>
                        <td>@f.Raza</td>
                        <td>@f.DuenoNombre</td>
                        <td class="text-end">@f.CantidadPaseos</td>
                        <td class="text-end">@f.Minutos</td>
                        <td class="text-end">@f.Total.ToString("N2")</td>
                        <td>@(f.UltimoPaseo.HasValue ? f.UltimoPaseo.Value.ToString("dd/MM/yyyy HH:mm") : "Sin paseos")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ActividadPerroDTO>? filas;
    private DateTime desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime hasta = DateTime.Today;
    private string? mensajeError;
    private bool cargando;

    protected override async Task OnInitializedAsync()
    {
        // El menú esconde el link, pero por URL directa la página se dibujaba igual y la API devolvía 403
        await Sesion.CargarAsync();
        if (!Sesion.EsAdmin)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await GenerarAsync();
    }

    private async Task GenerarAsync()
    {
        mensajeError = null;

        if (desde.Date > hasta.Date)
        {
            mensajeError = "La fecha desde no puede ser posterior a la fecha hasta.";
            return;
        }

        cargando = true;
        try
        {
            filas = await ReporteApi.GetActividadPerrosAsync(desde, hasta);
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "Los reportes son solo para el administrador.";
            filas = new();
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
