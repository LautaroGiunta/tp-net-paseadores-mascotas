@page "/reportes/recaudacion"
@using DTOs
@using API.Clients
@inject ReporteApiClient ReporteApi
@inject PaseadorApiClient PaseadorApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Recaudación mensual</PageTitle>

<div class="container mt-4">
    <h2>Recaudación mensual por paseador</h2>
    <p class="text-muted">Solo cuenta los paseos que ya se realizaron.</p>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label">Desde</label>
            <input type="date" class="form-control" @bind="desde" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Hasta</label>
            <input type="date" class="form-control" @bind="hasta" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" @onclick="GenerarAsync" disabled="@cargando">
                @(cargando ? "Generando..." : "Generar")
            </button>
        </div>
        @if (filas != null && filas.Any())
        {
            <div class="col-md-4 fw-bold">
                Total: $@filas.Sum(f => f.Total).ToString("N2") en @filas.Sum(f => f.CantidadPaseos) paseos
            </div>
        }
    </div>

    @if (filas != null && !filas.Any())
    {
        <div class="alert alert-secondary">No hay paseos realizados en el período.</div>
    }

    @* El canvas siempre está en la página: Chart.js lo busca por id después de renderizar *@
    <div class="card mb-4" style="@(filas != null && filas.Any() ? "" : "display:none")">
        <div class="card-body" style="height: 360px;">
            <canvas id="graficoRecaudacion"></canvas>
        </div>
    </div>

    @if (filas != null && filas.Any())
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Mes</th>
                    <th>Paseador</th>
                    <th class="text-end">Paseos</th>
                    <th class="text-end">Minutos</th>
                    <th class="text-end">Recaudado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in filas)
                {
                    <tr>
                        <td>@NombreMes(f.Anio, f.Mes)</td>
                        <td>@f.PaseadorNombre</td>
                        <td class="text-end">@f.CantidadPaseos</td>
                        <td class="text-end">@f.Minutos</td>
                        <td class="text-end">@f.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    // Mismo orden fijo que en escritorio (PaletaGraficos): el color sigue al paseador
    private static readonly string[] Paleta =
    {
        "#2a78d6", "#eb6834", "#1baf7a", "#eda100",
        "#e87ba4", "#008300", "#4a3aa7", "#e34948"
    };
    private const string ColorOtros = "#9a9893";

    private List<RecaudacionMensualDTO>? filas;
    private List<PaseadorDTO> paseadores = new();
    private DateTime desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-5);
    private DateTime hasta = DateTime.Today;
    private string? mensajeError;
    private bool cargando;
    private bool dibujarPendiente;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            paseadores = (await PaseadorApi.GetAllAsync()).OrderBy(p => p.Id).ToList();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
            return;
        }

        await GenerarAsync();
    }

    private async Task GenerarAsync()
    {
        mensajeError = null;

        if (desde.Date > hasta.Date)
        {
            mensajeError = "La fecha desde no puede ser posterior a la fecha hasta.";
            return;
        }

        cargando = true;
        try
        {
            filas = await ReporteApi.GetRecaudacionMensualAsync(desde, hasta);
            dibujarPendiente = true;
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "Los reportes son solo para el administrador.";
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    // El gráfico se dibuja cuando el canvas ya está visible en la página
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!dibujarPendiente || filas == null || !filas.Any())
            return;

        dibujarPendiente = false;

        var meses = filas.Select(f => new DateTime(f.Anio, f.Mes, 1)).Distinct().OrderBy(m => m).ToList();
        var series = ArmarSeries(meses);

        await JSRuntime.InvokeVoidAsync("graficos.barrasAgrupadas", "graficoRecaudacion",
            meses.Select(m => NombreMes(m.Year, m.Month)).ToArray(), series, "Recaudado ($)");
    }

    // Una serie por paseador con datos; del noveno en adelante van juntos a "Otros"
    private List<object> ArmarSeries(List<DateTime> meses)
    {
        var conDatos = filas!.Select(f => f.PaseadorId).Distinct().ToHashSet();
        var series = new List<object>();
        var otros = new List<int>();

        for (int i = 0; i < paseadores.Count; i++)
        {
            if (!conDatos.Contains(paseadores[i].Id))
                continue;

            if (i < Paleta.Length)
                series.Add(Serie($"{paseadores[i].Apellido}, {paseadores[i].Nombre}", Paleta[i], new[] { paseadores[i].Id }, meses));
            else
                otros.Add(paseadores[i].Id);
        }

        otros.AddRange(conDatos.Where(id => !paseadores.Any(p => p.Id == id)));
        if (otros.Any())
            series.Add(Serie("Otros", ColorOtros, otros.ToArray(), meses));

        return series;
    }

    private object Serie(string nombre, string color, int[] ids, List<DateTime> meses)
    {
        return new
        {
            nombre,
            color,
            valores = meses.Select(m => filas!
                .Where(f => f.Anio == m.Year && f.Mes == m.Month && ids.Contains(f.PaseadorId))
                .Sum(f => f.Total)).ToArray()
        };
    }

    private static string NombreMes(int anio, int mes)
    {
        return new DateTime(anio, mes, 1).ToString("MMM yyyy");
    }
}
