@page "/"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Inicio</PageTitle>

<h1>Panel Principal</h1>
<p>Bienvenido al sistema de gestión de paseadores.</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        // 1. Buscamos el token en el Local Storage
        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "token_seguridad");

        // 2. Si el token está vacío (no existe), lo mandamos de una al Login
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
        }
    }
}