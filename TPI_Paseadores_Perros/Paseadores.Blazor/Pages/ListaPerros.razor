@page "/perros"
@using DTOs
@using API.Clients
@inject PerroApiClient PerroApi
@inject DuenoApiClient DuenoApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h2>Perros</h2>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
    @if (!string.IsNullOrEmpty(mensajeOk))
    {
        <div class="alert alert-success">@mensajeOk</div>
    }

    <!-- ===== FORMULARIO ===== -->
    <div class="card mb-4">
        <div class="card-header">
            @(EsAlta ? "Nuevo perro" : $"Editando perro #{perro.Id}")
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="perro.Nombre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Raza</label>
                    <input class="form-control" @bind="perro.Raza" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Edad</label>
                    <input type="number" class="form-control" @bind="perro.Edad" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Dueño</label>
                    <select class="form-select" @bind="perro.DuenoId">
                        <option value="0">-- Elegir --</option>
                        @if (listaDuenos != null)
                        {
                            @foreach (var d in listaDuenos)
                            {
                                <option value="@d.Id">@d.Nombre @d.Apellido</option>
                            }
                        }
                    </select>
                </div>
            </div>

            @if (erroresValidacion.Any())
            {
                <ul class="alert alert-warning mt-3 mb-0">
                    @foreach (var error in erroresValidacion)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Guardar" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
                <button class="btn btn-secondary" @onclick="Limpiar" disabled="@guardando">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- ===== FILTRO POR DUEÑO ===== -->
    <div class="input-group mb-3">
        <span class="input-group-text">Filtrar por dueño</span>
        <select class="form-select" @bind="filtroDuenoId" @bind:after="CargarAsync">
            <option value="0">Todos los dueños</option>
            @if (listaDuenos != null)
            {
                @foreach (var d in listaDuenos)
                {
                    <option value="@d.Id">@d.Nombre @d.Apellido</option>
                }
            }
        </select>
    </div>

    <!-- ===== LISTADO ===== -->
    @if (listaPerros == null)
    {
        <div class="alert alert-info">Cargando datos...</div>
    }
    else if (!listaPerros.Any())
    {
        <div class="alert alert-secondary">No se encontraron perros.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Raza</th>
                    <th>Edad</th>
                    <th>Dueño</th>
                    <th style="width: 160px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in listaPerros)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nombre</td>
                        <td>@p.Raza</td>
                        <td>@p.Edad</td>
                        <td>@p.DuenoNombre</td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => Editar(p)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(p)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<PerroDTO>? listaPerros;
    private List<DuenoDTO>? listaDuenos;      // para el combo y el filtro
    private PerroDTO perro = new PerroDTO();
    private List<string> erroresValidacion = new();
    private string? mensajeError;
    private string? mensajeOk;
    private int filtroDuenoId;                // 0 = todos
    private bool guardando;

    // Id 0 = todavía no existe en la base => es un alta
    private bool EsAlta => perro.Id == 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarDuenosAsync();
        await CargarAsync();
    }

    // El combo necesita los dueños para poder elegir a quién pertenece el perro
    private async Task CargarDuenosAsync()
    {
        try
        {
            listaDuenos = await DuenoApi.GetAllAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            // Con filtro usamos el endpoint anidado /duenos/{id}/perros
            listaPerros = filtroDuenoId == 0
                ? await PerroApi.GetAllAsync()
                : await PerroApi.GetByDuenoAsync(filtroDuenoId);
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
    }

    // --- Validación a nivel UI (la misma que FormPerros) ---
    private bool EsValido()
    {
        erroresValidacion.Clear();

        if (string.IsNullOrWhiteSpace(perro.Nombre))
        {
            erroresValidacion.Add("El nombre es obligatorio.");
        }

        if (string.IsNullOrWhiteSpace(perro.Raza))
        {
            erroresValidacion.Add("La raza es obligatoria.");
        }

        if (perro.Edad < 0 || perro.Edad > 30)
        {
            erroresValidacion.Add("La edad debe estar entre 0 y 30 años.");
        }

        if (perro.DuenoId <= 0)
        {
            erroresValidacion.Add("Hay que elegir un dueño.");
        }

        return !erroresValidacion.Any();
    }

    private async Task Guardar()
    {
        mensajeError = null;
        mensajeOk = null;

        if (!EsValido())
        {
            return;
        }

        guardando = true;

        try
        {
            if (EsAlta)
            {
                await PerroApi.AddAsync(perro);
            }
            else
            {
                await PerroApi.UpdateAsync(perro);
            }

            mensajeOk = EsAlta ? "Perro creado con éxito." : "Perro actualizado con éxito.";
            Limpiar();
            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para esta operación (Admin o Dueño).";
        }
        catch (ApiException ex)
        {
            // Reglas de negocio del servicio (ej: el dueño no existe)
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(PerroDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;
        erroresValidacion.Clear();

        // Copia: si editáramos el objeto de la lista, la tabla mostraría los cambios
        // sin haberlos guardado todavía
        perro = new PerroDTO
        {
            Id = seleccionado.Id,
            Nombre = seleccionado.Nombre,
            Raza = seleccionado.Raza,
            Edad = seleccionado.Edad,
            DuenoId = seleccionado.DuenoId
        };
    }

    private async Task Eliminar(PerroDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;

        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Seguro que querés eliminar a {seleccionado.Nombre}?");

        if (!confirmado)
        {
            return;
        }

        try
        {
            await PerroApi.DeleteAsync(seleccionado.Id);
            mensajeOk = "Perro eliminado.";

            if (perro.Id == seleccionado.Id)
            {
                Limpiar();
            }

            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para eliminar (Admin o Dueño).";
        }
        catch (ApiException ex)
        {
            // Ej: "No se puede eliminar el perro porque tiene paseos registrados."
            mensajeError = ex.Message;
        }
    }

    private void Limpiar()
    {
        perro = new PerroDTO();
        erroresValidacion.Clear();
    }
}
