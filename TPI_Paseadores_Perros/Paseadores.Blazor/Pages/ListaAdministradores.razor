@page "/administradores"
@using DTOs
@using API.Clients
@inject AdministradorApiClient AdministradorApi
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h2>Administradores</h2>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
    @if (!string.IsNullOrEmpty(mensajeOk))
    {
        <div class="alert alert-success">@mensajeOk</div>
    }

    <!-- ===== FORMULARIO ===== -->
    <div class="card mb-4">
        <div class="card-header">
            @(EsAlta ? "Nuevo administrador" : $"Editando administrador #{administrador.Id}")
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="administrador.Nombre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Apellido</label>
                    <input class="form-control" @bind="administrador.Apellido" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="administrador.Email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" @bind="administrador.Telefono" placeholder="Solo números" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">
                        Contraseña
                        @if (!EsAlta)
                        {
                            <small class="text-muted">(vacío = no cambiar)</small>
                        }
                    </label>
                    <input type="password" class="form-control" @bind="administrador.Contrasena" />
                </div>
            </div>

            @if (erroresValidacion.Any())
            {
                <ul class="alert alert-warning mt-3 mb-0">
                    @foreach (var error in erroresValidacion)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Guardar" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
                <button class="btn btn-secondary" @onclick="Limpiar" disabled="@guardando">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- ===== LISTADO ===== -->
    @if (listaAdministradores == null)
    {
        <div class="alert alert-info">Cargando datos...</div>
    }
    else if (!listaAdministradores.Any())
    {
        <div class="alert alert-secondary">No hay administradores cargados.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Alta</th>
                    <th style="width: 160px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in listaAdministradores)
                {
                    <tr>
                        <td>@a.Id</td>
                        <td>@a.Nombre</td>
                        <td>@a.Apellido</td>
                        <td>@a.Email</td>
                        <td>@a.Telefono</td>
                        <td>@a.FechaAlta.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => Editar(a)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(a)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<UsuarioDTO>? listaAdministradores;
    private UsuarioDTO administrador = new UsuarioDTO();   // el que se está editando o dando de alta
    private List<string> erroresValidacion = new();
    private string? mensajeError;
    private string? mensajeOk;
    private bool guardando;

    // Id 0 = todavía no existe en la base => es un alta
    private bool EsAlta => administrador.Id == 0;

    protected override async Task OnInitializedAsync()
    {
        // El menú esconde el link, pero por URL directa la página se dibujaba igual y la API devolvía 403
        await Sesion.CargarAsync();
        if (!Sesion.EsAdmin)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        try
        {
            listaAdministradores = await AdministradorApi.GetAllAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "Solo un administrador puede ver esta sección.";
            listaAdministradores = new();
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
    }

    // --- Validación a nivel UI (la misma que FormAdministradores) ---
    private bool EsValido()
    {
        erroresValidacion.Clear();

        if (string.IsNullOrWhiteSpace(administrador.Nombre))
            erroresValidacion.Add("El nombre es obligatorio.");

        if (string.IsNullOrWhiteSpace(administrador.Apellido))
            erroresValidacion.Add("El apellido es obligatorio.");

        if (!System.Text.RegularExpressions.Regex.IsMatch(administrador.Email ?? "", @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
            erroresValidacion.Add("El email no tiene un formato válido.");

        if (!System.Text.RegularExpressions.Regex.IsMatch(administrador.Telefono ?? "", @"^[0-9]{8,15}$"))
            erroresValidacion.Add("El teléfono debe tener entre 8 y 15 números, sin espacios ni letras.");

        // En el alta la contraseña es obligatoria; en la edición, vacía significa "no cambiar"
        if (EsAlta && (administrador.Contrasena ?? "").Length < 8)
            erroresValidacion.Add("La contraseña debe tener al menos 8 caracteres.");
        else if (!EsAlta && !string.IsNullOrEmpty(administrador.Contrasena) && administrador.Contrasena.Length < 8)
            erroresValidacion.Add("La contraseña nueva debe tener al menos 8 caracteres.");

        return !erroresValidacion.Any();
    }

    private async Task Guardar()
    {
        mensajeError = null;
        mensajeOk = null;

        if (!EsValido())
            return;

        guardando = true;

        try
        {
            if (EsAlta)
                await AdministradorApi.AddAsync(administrador);
            else
                await AdministradorApi.UpdateAsync(administrador);

            mensajeOk = EsAlta ? "Administrador creado con éxito." : "Administrador actualizado con éxito.";
            Limpiar();
            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para esta operación (solo Admin).";
        }
        catch (ApiException ex)
        {
            // Reglas de negocio del servicio (email repetido, teléfono inválido...)
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(UsuarioDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;
        erroresValidacion.Clear();

        // Copia: si editáramos el objeto de la lista, la tabla mostraría los cambios
        // sin haberlos guardado todavía
        administrador = new UsuarioDTO
        {
            Id = seleccionado.Id,
            Nombre = seleccionado.Nombre,
            Apellido = seleccionado.Apellido,
            Email = seleccionado.Email,
            Telefono = seleccionado.Telefono,
            Contrasena = ""     // vacía a propósito: la API no la devuelve
        };
    }

    private async Task Eliminar(UsuarioDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;

        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Seguro que querés eliminar a {seleccionado.Nombre} {seleccionado.Apellido}?");

        if (!confirmado)
            return;

        try
        {
            await AdministradorApi.DeleteAsync(seleccionado.Id);
            mensajeOk = "Administrador eliminado.";

            if (administrador.Id == seleccionado.Id)
                Limpiar();

            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para eliminar (solo Admin).";
        }
        catch (ApiException ex)
        {
            // Ej: "No podés eliminar tu propio usuario."
            mensajeError = ex.Message;
        }
    }

    private void Limpiar()
    {
        administrador = new UsuarioDTO();
        erroresValidacion.Clear();
    }
}
