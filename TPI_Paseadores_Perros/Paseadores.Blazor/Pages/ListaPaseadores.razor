@page "/paseadores"
@using DTOs
@using API.Clients
@using Microsoft.AspNetCore.Components.Web
@inject PaseadorApiClient PaseadorApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h2>Paseadores</h2>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
    @if (!string.IsNullOrEmpty(mensajeOk))
    {
        <div class="alert alert-success">@mensajeOk</div>
    }

    <!-- ===== FORMULARIO ===== -->
    <div class="card mb-4">
        <div class="card-header">
            @(EsAlta ? "Nuevo paseador" : $"Editando paseador #{paseador.Id}")
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="paseador.Nombre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Apellido</label>
                    <input class="form-control" @bind="paseador.Apellido" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="paseador.Email" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" @bind="paseador.Telefono" placeholder="Solo números" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Zona</label>
                    <input class="form-control" @bind="paseador.Zona" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tarifa por hora</label>
                    <input type="number" step="0.01" class="form-control" @bind="paseador.TarifaPorHora" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        Contraseña
                        @if (!EsAlta)
                        {
                            <small class="text-muted">(vacío = no cambiar)</small>
                        }
                    </label>
                    <input type="password" class="form-control" @bind="paseador.Contrasena" />
                </div>
            </div>

            @if (erroresValidacion.Any())
            {
                <ul class="alert alert-warning mt-3 mb-0">
                    @foreach (var error in erroresValidacion)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Guardar" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
                <button class="btn btn-secondary" @onclick="Limpiar" disabled="@guardando">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- ===== BUSQUEDA CON FILTRO ===== -->
    <div class="input-group mb-3">
        <input class="form-control" placeholder="Buscar por nombre, apellido o zona..."
               @bind="textoBusqueda" @bind:event="oninput" @onkeyup="BuscarAlEnter" />
        <button class="btn btn-outline-primary" @onclick="Buscar">Buscar</button>
        <button class="btn btn-outline-secondary" @onclick="LimpiarBusqueda">Ver todos</button>
    </div>

    <!-- ===== LISTADO ===== -->
    @if (listaPaseadores == null)
    {
        <div class="alert alert-info">Cargando datos...</div>
    }
    else if (!listaPaseadores.Any())
    {
        <div class="alert alert-secondary">No se encontraron paseadores.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Zona</th>
                    <th>Tarifa</th>
                    <th style="width: 160px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in listaPaseadores)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nombre</td>
                        <td>@p.Apellido</td>
                        <td>@p.Email</td>
                        <td>@p.Telefono</td>
                        <td>@p.Zona</td>
                        <td>@p.TarifaPorHora.ToString("C")</td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => Editar(p)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(p)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<PaseadorDTO>? listaPaseadores;
    private PaseadorDTO paseador = new PaseadorDTO();
    private List<string> erroresValidacion = new();
    private string? mensajeError;
    private string? mensajeOk;
    private string textoBusqueda = "";
    private bool guardando;

    // Id 0 = todavía no existe en la base => es un alta
    private bool EsAlta => paseador.Id == 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        try
        {
            // Si hay texto en el filtro, respetamos la búsqueda al recargar
            listaPaseadores = string.IsNullOrWhiteSpace(textoBusqueda)
                ? await PaseadorApi.GetAllAsync()
                : await PaseadorApi.BuscarAsync(textoBusqueda);
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
    }

    private async Task Buscar()
    {
        mensajeError = null;
        mensajeOk = null;
        await CargarAsync();
    }

    private async Task BuscarAlEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task LimpiarBusqueda()
    {
        textoBusqueda = "";
        await CargarAsync();
    }

    // --- Validación a nivel UI (la misma que FormPaseadores) ---
    private bool EsValido()
    {
        erroresValidacion.Clear();

        if (string.IsNullOrWhiteSpace(paseador.Nombre))
        {
            erroresValidacion.Add("El nombre es obligatorio.");
        }

        if (string.IsNullOrWhiteSpace(paseador.Apellido))
        {
            erroresValidacion.Add("El apellido es obligatorio.");
        }

        if (string.IsNullOrWhiteSpace(paseador.Zona))
        {
            erroresValidacion.Add("La zona es obligatoria.");
        }

        if (string.IsNullOrWhiteSpace(paseador.Email) || !paseador.Email.Contains("@"))
        {
            erroresValidacion.Add("El email no tiene un formato válido.");
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(paseador.Telefono ?? "", @"^[0-9]{8,15}$"))
        {
            erroresValidacion.Add("El teléfono debe tener entre 8 y 15 números, sin espacios ni letras.");
        }

        if (paseador.TarifaPorHora <= 0)
        {
            erroresValidacion.Add("La tarifa por hora debe ser mayor a cero.");
        }

        // En el alta la contraseña es obligatoria; en la edición, vacía significa "no cambiar"
        if (EsAlta && (paseador.Contrasena ?? "").Length < 8)
        {
            erroresValidacion.Add("La contraseña debe tener al menos 8 caracteres.");
        }
        else if (!EsAlta && !string.IsNullOrEmpty(paseador.Contrasena) && paseador.Contrasena.Length < 8)
        {
            erroresValidacion.Add("La contraseña nueva debe tener al menos 8 caracteres.");
        }

        return !erroresValidacion.Any();
    }

    private async Task Guardar()
    {
        mensajeError = null;
        mensajeOk = null;

        if (!EsValido())
        {
            return;
        }

        guardando = true;

        try
        {
            if (EsAlta)
            {
                await PaseadorApi.AddAsync(paseador);
            }
            else
            {
                await PaseadorApi.UpdateAsync(paseador);
            }

            mensajeOk = EsAlta ? "Paseador creado con éxito." : "Paseador actualizado con éxito.";
            Limpiar();
            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para esta operación (solo Admin).";
        }
        catch (ApiException ex)
        {
            // Reglas de negocio del servicio (email duplicado, tarifa, etc.)
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(PaseadorDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;
        erroresValidacion.Clear();

        // Copia: si editáramos el objeto de la lista, la tabla mostraría los cambios
        // sin haberlos guardado todavía
        paseador = new PaseadorDTO
        {
            Id = seleccionado.Id,
            Nombre = seleccionado.Nombre,
            Apellido = seleccionado.Apellido,
            Email = seleccionado.Email,
            Telefono = seleccionado.Telefono,
            Zona = seleccionado.Zona,
            TarifaPorHora = seleccionado.TarifaPorHora,
            Contrasena = ""     // vacía a propósito: la API no la devuelve
        };
    }

    private async Task Eliminar(PaseadorDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;

        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Seguro que querés eliminar a {seleccionado.Nombre} {seleccionado.Apellido}?");

        if (!confirmado)
        {
            return;
        }

        try
        {
            await PaseadorApi.DeleteAsync(seleccionado.Id);
            mensajeOk = "Paseador eliminado.";

            if (paseador.Id == seleccionado.Id)
            {
                Limpiar();
            }

            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para eliminar (solo Admin).";
        }
        catch (ApiException ex)
        {
            // Ej: "No se puede eliminar el paseador porque tiene paseos registrados."
            mensajeError = ex.Message;
        }
    }

    private void Limpiar()
    {
        paseador = new PaseadorDTO();
        erroresValidacion.Clear();
    }
}
