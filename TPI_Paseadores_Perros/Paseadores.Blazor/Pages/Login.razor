@page "/login"
@using DTOs
@using API.Clients
@inject AuthApiClient AuthApi
@inject NavigationManager Navigation
@inject SesionService Sesion

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="text-center mb-4">Iniciar Sesión</h3>

                    <div class="mb-3">
                        <label>Email</label>
                        <input type="email" @bind="loginData.Email" class="form-control" placeholder="admin@paseos.com" />
                    </div>

                    <div class="mb-3">
                        <label>Contraseña</label>
                        <input type="password" @bind="loginData.Contrasena" class="form-control" placeholder="******" />
                    </div>

                    <button class="btn btn-primary w-100" @onclick="Ingresar" disabled="@ingresando">
                        @(ingresando ? "Ingresando..." : "Ingresar")
                    </button>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger mt-3">@mensajeError</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequestDTO loginData = new LoginRequestDTO();
    private string? mensajeError;
    private bool ingresando;

    // Llegar al login (a mano o por un 401 de token vencido) cierra la sesión anterior
    protected override async Task OnInitializedAsync()
    {
        if (Sesion.EstaLogueado)
        {
            await Sesion.CerrarAsync();
        }
    }

    private async Task Ingresar()
    {
        mensajeError = null;

        // Validación a nivel UI: no molestamos a la API si falta algo
        if (string.IsNullOrWhiteSpace(loginData.Email) || string.IsNullOrWhiteSpace(loginData.Contrasena))
        {
            mensajeError = "Ingresá el email y la contraseña.";
            return;
        }

        ingresando = true;

        try
        {
            var respuesta = await AuthApi.LoginAsync(loginData);

            if (respuesta == null)
            {
                mensajeError = "La API no devolvió datos de sesión.";
                return;
            }

            // Guarda el token (lo usa el AuthTokenHandler) y avisa al menú el rol
            await Sesion.IniciarAsync(respuesta);

            Navigation.NavigateTo("/");
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            mensajeError = "Email o contraseña incorrectos.";
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
        catch (HttpRequestException)
        {
            mensajeError = "No se pudo conectar con la API. ¿Está levantada?";
        }
        finally
        {
            ingresando = false;
        }
    }
}
