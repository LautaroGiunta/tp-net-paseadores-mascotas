@page "/duenos"
@using DTOs
@using API.Clients
@inject DuenoApiClient DuenoApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <h2>Dueños</h2>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
    @if (!string.IsNullOrEmpty(mensajeOk))
    {
        <div class="alert alert-success">@mensajeOk</div>
    }

    <!-- ===== FORMULARIO ===== -->
    <div class="card mb-4">
        <div class="card-header">
            @(EsAlta ? "Nuevo dueño" : $"Editando dueño #{dueno.Id}")
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="dueno.Nombre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Apellido</label>
                    <input class="form-control" @bind="dueno.Apellido" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="dueno.Email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" @bind="dueno.Telefono" placeholder="Solo números" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Dirección</label>
                    <input class="form-control" @bind="dueno.Direccion" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">
                        Contraseña
                        @if (!EsAlta)
                        {
                            <small class="text-muted">(vacío = no cambiar)</small>
                        }
                    </label>
                    <input type="password" class="form-control" @bind="dueno.Contrasena" />
                </div>
            </div>

            @if (erroresValidacion.Any())
            {
                <ul class="alert alert-warning mt-3 mb-0">
                    @foreach (var error in erroresValidacion)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Guardar" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
                <button class="btn btn-secondary" @onclick="Limpiar" disabled="@guardando">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- ===== LISTADO ===== -->
    @if (listaDuenos == null)
    {
        <div class="alert alert-info">Cargando datos...</div>
    }
    else if (!listaDuenos.Any())
    {
        <div class="alert alert-secondary">No hay dueños cargados.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th style="width: 160px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in listaDuenos)
                {
                    <tr>
                        <td>@d.Id</td>
                        <td>@d.Nombre</td>
                        <td>@d.Apellido</td>
                        <td>@d.Email</td>
                        <td>@d.Telefono</td>
                        <td>@d.Direccion</td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => Editar(d)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(d)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<DuenoDTO>? listaDuenos;
    private DuenoDTO dueno = new DuenoDTO();      // el que se está editando o dando de alta
    private List<string> erroresValidacion = new();
    private string? mensajeError;
    private string? mensajeOk;
    private bool guardando;

    // Id 0 = todavía no existe en la base => es un alta
    private bool EsAlta => dueno.Id == 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        try
        {
            listaDuenos = await DuenoApi.GetAllAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            mensajeError = ex.Message;
        }
    }

    // --- Validación a nivel UI (misma que FormDueños) ---
    private bool EsValido()
    {
        erroresValidacion.Clear();

        if (string.IsNullOrWhiteSpace(dueno.Nombre))
            erroresValidacion.Add("El nombre es obligatorio.");

        if (string.IsNullOrWhiteSpace(dueno.Apellido))
            erroresValidacion.Add("El apellido es obligatorio.");

        if (string.IsNullOrWhiteSpace(dueno.Direccion))
            erroresValidacion.Add("La dirección es obligatoria.");

        if (string.IsNullOrWhiteSpace(dueno.Email) || !dueno.Email.Contains('@'))
            erroresValidacion.Add("El email no tiene un formato válido.");

        if (!System.Text.RegularExpressions.Regex.IsMatch(dueno.Telefono ?? "", @"^[0-9]{8,15}$"))
            erroresValidacion.Add("El teléfono debe tener entre 8 y 15 números, sin espacios ni letras.");

        // En el alta la contraseña es obligatoria; en la edición, vacía significa "no cambiar"
        if (EsAlta && (dueno.Contrasena ?? "").Length < 8)
            erroresValidacion.Add("La contraseña debe tener al menos 8 caracteres.");
        else if (!EsAlta && !string.IsNullOrEmpty(dueno.Contrasena) && dueno.Contrasena.Length < 8)
            erroresValidacion.Add("La contraseña nueva debe tener al menos 8 caracteres.");

        return !erroresValidacion.Any();
    }

    private async Task Guardar()
    {
        mensajeError = null;
        mensajeOk = null;

        if (!EsValido())
            return;

        guardando = true;

        try
        {
            if (EsAlta)
                await DuenoApi.AddAsync(dueno);
            else
                await DuenoApi.UpdateAsync(dueno);

            mensajeOk = EsAlta ? "Dueño creado con éxito." : "Dueño actualizado con éxito.";
            Limpiar();
            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para esta operación (solo Admin).";
        }
        catch (ApiException ex)
        {
            // Acá caen las reglas de negocio que rechaza el servicio (email duplicado, etc.)
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(DuenoDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;
        erroresValidacion.Clear();

        // Copia: si editáramos el objeto de la lista, la tabla mostraría los cambios
        // sin haberlos guardado todavía
        dueno = new DuenoDTO
        {
            Id = seleccionado.Id,
            Nombre = seleccionado.Nombre,
            Apellido = seleccionado.Apellido,
            Email = seleccionado.Email,
            Telefono = seleccionado.Telefono,
            Direccion = seleccionado.Direccion,
            Contrasena = ""     // vacía a propósito: la API no la devuelve
        };
    }

    private async Task Eliminar(DuenoDTO seleccionado)
    {
        mensajeError = null;
        mensajeOk = null;

        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Seguro que querés eliminar a {seleccionado.Nombre} {seleccionado.Apellido}?");

        if (!confirmado)
            return;

        try
        {
            await DuenoApi.DeleteAsync(seleccionado.Id);
            mensajeOk = "Dueño eliminado.";

            // Si estaba en el formulario, lo sacamos
            if (dueno.Id == seleccionado.Id)
                Limpiar();

            await CargarAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex) when (ex.StatusCode == 403)
        {
            mensajeError = "No tenés permisos para eliminar (solo Admin).";
        }
        catch (ApiException ex)
        {
            // Ej: "No se puede eliminar el dueño porque tiene perros registrados."
            mensajeError = ex.Message;
        }
    }

    private void Limpiar()
    {
        dueno = new DuenoDTO();
        erroresValidacion.Clear();
    }
}