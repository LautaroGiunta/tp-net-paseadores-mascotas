@inherits LayoutComponentBase
@implements IDisposable
@inject SesionService Sesion
@inject NavigationManager Navigation

<div class="page">
    @if (Sesion.EstaLogueado)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        @if (Sesion.EstaLogueado)
        {
            <div class="top-row px-4">
                <span>@Sesion.Nombre (@Sesion.Rol)</span>
                <button class="btn btn-link" @onclick="CerrarSesion">Cerrar sesión</button>
            </div>
        }

        <article class="content px-4">
            @if (sesionCargada)
            {
                @Body
            }
        </article>
    </main>
</div>

@code {
    private bool sesionCargada;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarAsync();
        sesionCargada = true;

        Sesion.OnChange += StateHasChanged;
        Navigation.LocationChanged += AlCambiarDeRuta;
        ExigirSesion();
    }

    // Todas las páginas menos el login necesitan sesión iniciada
    private void ExigirSesion()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!Sesion.EstaLogueado && !ruta.StartsWith("login", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void AlCambiarDeRuta(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ExigirSesion();
    }

    private async Task CerrarSesion()
    {
        await Sesion.CerrarAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        Sesion.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= AlCambiarDeRuta;
    }
}
